{
  "manifest_version": 3,
  "name": "X Timeline Capture (personal KB)",
  "version": "1.1.0",
  "description": "Give handles + start/end date; captures posts, replies, quotes and long-form notes from your logged-in X session into JSON for the stockmarket KB. Personal use; no data leaves your browser.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "alarms",
    "tabs",
    "scripting",
    "offscreen",
    "nativeMessaging"
  ],
  "host_permissions": ["https://x.com/*", "https://abs.twimg.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "X Timeline Capture"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["core.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
