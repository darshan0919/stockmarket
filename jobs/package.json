{
  "name": "@stock/jobs",
  "version": "0.1.0",
  "private": true,
  "description": "Cowork automation jobs (ported from Company Research Python) running on @stock/api.",
  "type": "commonjs",
  "scripts": {
    "test": "jest",
    "data:doctor": "node lib/driveDataStore.js doctor",
    "data:init": "node lib/driveDataStore.js init",
    "data:pull": "node lib/driveDataStore.js pull",
    "data:push": "node lib/driveDataStore.js push",
    "data:sync": "node lib/driveDataStore.js sync",
    "data:manifest": "node lib/driveDataStore.js manifest",
    "data:auth": "node scripts/googleAuth.js",
    "data:offload": "node scripts/offloadToDrive.js",
    "ca-digest": "node corpActionsDigest.js",
    "deals-digest": "node dealsDigest.js",
    "weekly-ppt-insights": "node weeklyPptInsights.js",
    "order-book-digest": "node orderBookDigest.js",
    "mna-tracker": "node mnaTracker.js",
    "tasks:sync": "node scripts/sync-tasks.js",
    "tasks:push": "node scripts/sync-tasks.js --push",
    "tasks:pull": "node scripts/sync-tasks.js --pull",
    "tasks:diff": "node scripts/sync-tasks.js --push --dry-run"
  },
  "dependencies": {
    "@stock/api": "workspace:*",
    "googleapis": "^148.0.0",
    "pdf-parse": "^2.4.5"
  },
  "optionalDependencies": {
    "nodemailer": "^6.9.0"
  },
  "devDependencies": {
    "jest": "^30.2.0"
  }
}
