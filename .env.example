# ═══════════════════════════════════════════════════════════════════════════════
#  Stock Screener — Environment Variables Template
#  Copy this file to .env and fill in the values.
#     cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────────────────────
MONGO_URL=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# ── API Keys ─────────────────────────────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── Stockscans ───────────────────────────────────────────────────────────────
STOCKSCANS_AUTH_TOKEN=

# ── Screener.in (session cookies for the pre-PEAD insights cross-check) ───────
# Log in to screener.in, then DevTools → Application → Cookies → copy these.
# They expire; the pre-PEAD skill runs a preflight check and will tell you to
# refresh them here before running if the session is stale.
SCREENER_CSRFTOKEN=
SCREENER_SESSIONID=
# Optional: full Cookie header from a working screener.in request (overrides the pair)
SCREENER_COOKIES=

# ── Perplexity Finance (undocumented internal API — see PerplexityClient.js) ──
# Log in to perplexity.ai/finance, DevTools → Network → find a
# /rest/finance/earnings/*/transcript/* request, copy its full `cookie` header.
# Expect to refresh often: the cf_clearance cookie inside it is short-lived.
PERPLEXITY_COOKIES=
PERPLEXITY_ACCOUNT_ID=              # the same request's x-pplx-account header

# ── Email (Gmail) ────────────────────────────────────────────────────────────
GOOGLE_APP_PASSWORD=              # Gmail App Password (for cowork-jobs email service)

# ── Google Drive API (cowork-jobs) ───────────────────────────────────────────
# Generated by: yarn cowork:data:auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Learnyst (course-video transcript fetch — learnyst-transcript-refresh) ────
# Multi-site: each Learnyst-hosted school/membership is a "site" keyed by a
# short lowercase name (e.g. soic, chartitude), configured entirely through
# LEARNYST_<KEY>_* vars below — learnystTranscriptRefresh.js processes every
# site listed in LEARNYST_SITE_KEYS (default: soic,chartitude) that has an
# auth token set, or just one via `--site <key>`. Adding a new
# course/membership later is purely config: add its LEARNYST_<KEY>_* vars
# (and its key to LEARNYST_SITE_KEYS if you changed the default list) — no
# code change needed. See docs/learnyst-api-schemas.md for the DevTools steps
# to find a new site's school id, bundle id, and auth token.
# LEARNYST_SITE_KEYS=soic,chartitude

# schoolId/bundleId/origin identify a fixed membership, not something that
# varies per deployment, so they're baked into SITE_DEFAULTS in
# learnystTranscriptRefresh.js instead of duplicated here — only the auth
# token (which does expire) is a required env var for a site already listed
# there. The env var overrides below still work (e.g. to point at a
# not-yet-baked-in site, or override one that is).

# soic — Log into https://learn.soic.in, DevTools → Network → find any
# request to ai-api.learnyst.com or apig.learnyst.com, copy the
# `authorization`/`lystauthorization` header value (drop "Bearer "). Same
# token works for all 3 endpoints (docs/learnyst-api-schemas.md) — it's a JWT
# with a real `exp` claim, so it WILL expire; repeat the steps above for a
# fresh one when the job starts failing with 401/403.
LEARNYST_SOIC_AUTH_TOKEN=
# Optional overrides (defaults come from SITE_DEFAULTS.soic)
# LEARNYST_SOIC_SCHOOL_ID=110998
# LEARNYST_SOIC_BUNDLE_ID=97666
# LEARNYST_SOIC_GRAPHQL_URL=https://apig.learnyst.com/learn
# LEARNYST_SOIC_COURSES_API_BASE=https://apig.learnyst.com/learner/v17/courses
# LEARNYST_SOIC_TRANSCRIPT_API_BASE=https://ai-api.learnyst.com/api/transcript-data
# LEARNYST_SOIC_ORIGIN=https://learn.soic.in
# LEARNYST_SOIC_REFERER=https://learn.soic.in/
# LEARNYST_SOIC_REQUEST_DELAY_MS=1500     # delay between per-lesson transcript fetches
# LEARNYST_SOIC_MODULE_DELAY_MS=10000     # cooldown between modules
# LEARNYST_SOIC_MAX_RETRIES=4

# chartitude — https://learn.chartitude.com/learn/home/Chartitude-Membership.
# Same DevTools steps as soic above. schoolId (166281) is already baked into
# SITE_DEFAULTS.chartitude; bundleId isn't known yet — the site is skipped
# with a clear reason until it's found and added there (don't set it here,
# add it to SITE_DEFAULTS in learnystTranscriptRefresh.js once discovered).
LEARNYST_CHARTITUDE_AUTH_TOKEN=
# LEARNYST_CHARTITUDE_SCHOOL_ID=166281
# LEARNYST_CHARTITUDE_BUNDLE_ID=
# LEARNYST_CHARTITUDE_ORIGIN=https://learn.chartitude.com
# LEARNYST_CHARTITUDE_REFERER=https://learn.chartitude.com/
# LEARNYST_CHARTITUDE_REQUEST_DELAY_MS=1500
# LEARNYST_CHARTITUDE_MODULE_DELAY_MS=10000
# LEARNYST_CHARTITUDE_MAX_RETRIES=4

# ── YouTube (channel-video transcript fetch — youtube-transcript-refresh) ────
# Channel/video listing auth — plain API key preferred (simplest):
# console.cloud.google.com → your project → APIs & Services → Library →
# enable "YouTube Data API v3" → Credentials → Create Credentials → API key.
YOUTUBE_API_KEY=
# Fallback if YOUTUBE_API_KEY is unset: reuses the Drive OAuth2 credentials
# above (GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET/GOOGLE_REFRESH_TOKEN) — only
# works if that token's consent also includes
# https://www.googleapis.com/auth/youtube.readonly (the Drive-only token in
# this repo does NOT have it as of 2026-08-27 — re-run OAuth consent with
# that scope added, or just use YOUTUBE_API_KEY instead).
YOUTUBE_CHANNEL_HANDLE=SOICfinance
# Actual transcript TEXT is fetched via the yt-dlp CLI (a separate, system-
# level dependency — see docs/youtube-api-schemas.md §3/§4):
#   brew install yt-dlp
#   $(brew --prefix yt-dlp)/libexec/bin/python3 -m pip install curl_cffi
# curl_cffi enables `--impersonate chrome`, which yt-dlp needs to fetch
# captions reliably (a plain unauthenticated request gets an empty response
# from YouTube's anti-bot check as of 2026-08).
# If you're hitting YouTube 429s / "Sign in to confirm you're not a bot"
# quickly, set this to authenticate yt-dlp with your own logged-in browser
# session (yt-dlp reads the browser's cookie store directly — this repo
# never sees or handles the actual cookie values). Requires that browser to
# be logged into youtube.com; on macOS/Chrome you usually need the browser
# closed while yt-dlp reads its cookie DB (it'll error and tell you if so).
# YOUTUBE_YTDLP_COOKIES_FROM_BROWSER=chrome   # or: firefox, safari, edge, brave...
# Optional overrides
# YOUTUBE_CAPTION_LANG=en
# YOUTUBE_ALLOW_AUTO_CAPTIONS=true   # fall back to auto-generated captions if no manual ones exist
# YOUTUBE_REQUEST_DELAY_MS=4000      # delay between per-video caption fetches (bump higher for bulk backfills)
# YOUTUBE_MAX_RETRIES=4
# YOUTUBE_YTDLP_PATH=yt-dlp          # override if yt-dlp isn't on PATH
# YOUTUBE_YTDLP_IMPERSONATE=chrome   # yt-dlp --impersonate target

# ── Twitter / X.com GraphQL session (Tweet Downloader) ───────────────────────
# Required: logged-in session cookies from browser DevTools (see docs/API_REFERENCE.md#x-twitter-apis)
TWITTER_AUTH_TOKEN=
TWITTER_CSRF_TOKEN=
# Optional: full Cookie header from a working x.com request (overrides auth_token + ct0 above)
TWITTER_COOKIES=
# Optional: defaults to x.com public web bearer if unset
TWITTER_BEARER_TOKEN=
# Optional: UserTweets query id from Network tab (default matches current web client)
TWITTER_USER_TWEETS_QUERY_ID=
# Required for handle lookup: UserByScreenName query id from Network tab when opening a profile
TWITTER_USER_BY_SCREEN_NAME_QUERY_ID=
# Optional: browser user-agent string copied from DevTools
TWITTER_USER_AGENT=

# ═══════════════════════════════════════════════════════════════════════════════
#  Optional Overrides (uncomment as needed)
# ═══════════════════════════════════════════════════════════════════════════════
# RESEARCH_ROOT=                    # Path to research workspace (default: ~/Research)
# STOCKMARKET_BACKEND=              # Backend URL for Python skills (default: http://localhost:5000)
# COWORK_DATA_DIR=                  # Cowork-jobs data directory override
# COWORK_DRIVE_ROOT=                # Google Drive folder ID for data sync
# COWORK_DRIVE_EMAIL=               # Google Drive owner email
# COWORK_DRIVE_SYNC=                # Set to 0 to disable Drive sync
