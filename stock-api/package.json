{
  "name": "@stock/api",
  "version": "0.1.0",
  "private": true,
  "description": "Centralized stock-data API clients. Stockscans = fundamentals; NSE/BSE = price-action.",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./utils/*": "./src/utils/*.js",
    "./fetchers/*": "./src/fetchers/*.js",
    "./analyzers/*": "./src/analyzers/*.js",
    "./stockscansClient": "./src/clients/StockscansClient.js"
  },
  "sideEffects": false,
  "type": "commonjs",
  "scripts": {
    "test": "jest",
    "announcement-keyword-explorer": "node bin/announcement-keyword-explorer.js",
    "concall-analysis": "node bin/concall-analysis.js",
    "consecutive-filings-diff": "node bin/consecutive-filings-diff.js",
    "drhp-ipo-analysis": "node bin/drhp-ipo-analysis.js",
    "equity-research-deepdive": "node bin/equity-research-deepdive.js",
    "equity-research-extraction": "node bin/equity-research-extraction.js",
    "find-earnings-recording": "node bin/find-earnings-recording.js",
    "forensic-accounting": "node bin/forensic-accounting.js",
    "get-concall-sentiment": "node bin/get-concall-sentiment.js",
    "get-concall-transcript-url": "node bin/get-concall-transcript-url.js",
    "get-latest-concall-transcript": "node bin/get-latest-concall-transcript.js",
    "growth-triggers-1pager": "node bin/growth-triggers-1pager.js",
    "management-credibility-tracker": "node bin/management-credibility-tracker.js",
    "market-share-analysis": "node bin/market-share-analysis.js",
    "orchestrate": "node bin/orchestrate.js",
    "peer-comparison": "node bin/peer-comparison.js",
    "pre-pead-scanner": "node bin/pre-pead-scanner.js",
    "quarterly-result-analysis": "node bin/quarterly-result-analysis.js",
    "render-pdf": "node bin/render-pdf.js",
    "save-concall-transcript": "node bin/save-concall-transcript.js",
    "sector-research-deepdive": "node bin/sector-research-deepdive.js",
    "stock-documents-fetcher": "node bin/stock-documents-fetcher.js",
    "tweet-investor-playbook": "node bin/tweet-investor-playbook.js",
    "watchlist-catalyst-scanner": "node bin/watchlist-catalyst-scanner.js"
  },
  "dependencies": {
    "@stock/cloud-utils": "workspace:*",
    "axios": "^1.6.0",
    "puppeteer": "^25.2.1"
  },
  "devDependencies": {
    "jest": "^30.2.0"
  }
}
