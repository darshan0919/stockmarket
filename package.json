{
  "name": "stock-screener",
  "private": true,
  "packageManager": "yarn@3.8.7",
  "workspaces": [
    "screener-api",
    "screener-web",
    "stock-api",
    "jobs",
    "cloud-utils",
    "packages/jobs-runtime"
  ],
  "resolutions": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "next": "14.2.35"
  },
  "description": "Stock Screener monorepo (Yarn 3 workspaces)",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"yarn workspace screener-api dev\" \"yarn workspace screener-web dev\"",
    "build": "yarn workspace screener-web build",
    "start": "concurrently -n api,web -c cyan,magenta \"yarn workspace screener-api start\" \"yarn workspace screener-web start\"",
    "seed": "node screener-api/scripts/fetchData.js",
    "deploy:local": "yarn build && yarn start",
    "test": "yarn workspace screener-api test && yarn workspace screener-web test",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md}\"",
    "lint": "eslint . --ext .js,.jsx",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "dead-code:scan": "node scripts/dead-code-scanner.js",
    "antigravity:sync": "node scripts/antigravity-sync-tasks-and-skills.js",
    "antigravity:tasks-and-skills:sync": "node scripts/antigravity-sync-tasks-and-skills.js",
    "quality": "yarn format:check && yarn lint && yarn test",
    "deals-digest": "yarn workspace @stock/jobs deals-digest",
    "verify-deals-digest": "yarn workspace @stock/jobs verify-deals-digest",
    "daily-gainers-digest": "yarn workspace @stock/jobs daily-gainers-digest",
    "weekly-gainers-digest": "yarn workspace @stock/jobs weekly-gainers-digest",
    "near-highs-digest": "yarn workspace @stock/jobs near-highs-digest",
    "ca-digest": "yarn workspace @stock/jobs ca-digest",
    "order-book-digest": "yarn workspace @stock/jobs order-book-digest",
    "order-book-sync": "yarn workspace @stock/jobs order-book-sync",
    "weekly-ppt-insights": "yarn workspace @stock/jobs weekly-ppt-insights",
    "mna-tracker": "yarn workspace @stock/jobs mna-tracker",
    "gainers-scanner": "yarn workspace @stock/jobs gainers-scanner",
    "insight-validator": "yarn workspace @stock/jobs insight-validator",
    "watchlist-insights": "yarn workspace @stock/jobs watchlist-insights",
    "watchlist-updater": "yarn workspace @stock/jobs watchlist-updater",
    "ipo-subscription-scan": "yarn workspace @stock/jobs ipo-subscription-scan",
    "ipo-digest-email": "yarn workspace @stock/jobs ipo-digest-email",
    "ipo-backtest": "yarn workspace @stock/jobs ipo-backtest",
    "ipo-history-cache": "yarn workspace @stock/jobs ipo-history-cache",
    "nse-ipo-history-fetcher": "yarn workspace @stock/jobs nse-ipo-history-fetcher",
    "bse-ipo-history-fetcher": "yarn workspace @stock/jobs bse-ipo-history-fetcher",
    "cowork:jobs:ca-digest": "yarn workspace @stock/jobs ca-digest",
    "registries:generate": "node scripts/build/generate-registries.js",
    "data:push": "yarn workspace @stock/jobs-runtime data:push",
    "data:pull": "yarn workspace @stock/jobs-runtime data:pull",
    "data:status": "yarn workspace @stock/jobs-runtime data:status",
    "monthly-sales-tracker": "node scripts/skills/monthly-sales-tracker/run.js",
    "find-stray-artifacts": "node scripts/find_stray_artifacts.js"
  },
  "devDependencies": {
    "@duckdb/node-api": "^1.5.4-r.1",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.1",
    "prettier": "^3.2.5"
  }
}
