{
  "name": "stock-screener",
  "private": true,
  "packageManager": "yarn@3.8.7",
  "workspaces": [
    "screener-api",
    "screener-web",
    "stock-api",
    "jobs"
  ],
  "resolutions": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "next": "14.2.35"
  },
  "description": "Stock Screener monorepo (Yarn 3 workspaces)",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"yarn workspace screener-api dev\" \"yarn workspace screener-web dev\"",
    "build": "yarn workspace screener-web build",
    "start": "concurrently -n api,web -c cyan,magenta \"yarn workspace screener-api start\" \"yarn workspace screener-web start\"",
    "seed": "node screener-api/scripts/fetchData.js",
    "deploy:local": "yarn build && yarn start",
    "test": "yarn workspace screener-api test && yarn workspace screener-web test",
    "format": "yarn workspace screener-api format && yarn workspace screener-web format",
    "cowork:data:doctor": "yarn workspace @stock/jobs data:doctor",
    "cowork:data:init": "yarn workspace @stock/jobs data:init",
    "cowork:data:pull": "yarn workspace @stock/jobs data:pull",
    "cowork:data:push": "yarn workspace @stock/jobs data:push",
    "cowork:data:sync": "yarn workspace @stock/jobs data:sync",
    "cowork:data:manifest": "yarn workspace @stock/jobs data:manifest",
    "cowork:data:auth": "yarn workspace @stock/jobs data:auth",
    "cowork:data:offload": "yarn workspace @stock/jobs data:offload",
    "cowork:data:stockscans-ppts": "node scripts/fetchStockscansPpts.js && node scripts/extractPptText.js",
    "cowork:jobs:ca-digest": "yarn workspace @stock/jobs ca-digest",
    "tasks:sync": "node jobs/scripts/sync-tasks.js",
    "tasks:push": "node jobs/scripts/sync-tasks.js --push",
    "tasks:pull": "node jobs/scripts/sync-tasks.js --pull",
    "tasks:diff": "node jobs/scripts/sync-tasks.js --push --dry-run",
    "tasks:platforms": "node jobs/scripts/sync-tasks.js --list-platforms"
  },
  "devDependencies": {
    "@duckdb/node-api": "^1.5.4-r.1",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.1"
  }
}
