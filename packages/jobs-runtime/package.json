{
  "name": "@stock/jobs-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Cowork automation job runtime (entrypoint scripts + shared libs), ported from Company Research Python, running on @stock/api.",
  "type": "commonjs",
  "scripts": {
