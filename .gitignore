# Dependencies
node_modules/
package-lock.json

# Yarn Berry (keep releases + lockfile; ignore local cache)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Environment variables
.env
!.env.example
.env.local
.env*.local

# Build outputs
.next/
out/
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Testing
coverage/
.nyc_output/

# Temporary files
*.tmp
*.temp

# Local Drive listing cache (perf cache for jobs-runtime migrate-flat, transient)
packages/jobs-runtime/.cache/

# Downloads
downloads/

# Concall recordings (raw audio/video downloads + derived transcripts) —
# regenerable from source, must not be committed. Per DATA_RULES §1, transient
# raw material like this belongs in data/runs/ if it must persist at all; this
# top-level dir is a working scratch area for concall-transcript-extractor.
recordings/

# Uploaded research dashboards (per-symbol HTML)
backend/uploads/

# Stray generated artifacts (rendered PDFs/decks/reports) written to the repo
# root by a skill run whose output-path resolution fell back to process.cwd()
# instead of data/assets/<skill>/. Guard against re-committing these — if you
# see files matching these patterns land at the repo root, move them into
# data/assets/misc/ (or the producing skill's data/assets/<skill>/ subfolder)
# and delete them from here; see skills/development/dead-code-scanner/SKILL.md
# and scripts/find_stray_artifacts.js, which detects this class of mistake.
/*.pdf
/*.docx
/*.pptx
/*.xlsx
/*.mp3
/*.mp4
/*.webm
/*.wav
/*.zip


# ── Generated data — Data Ecosystem v2 (docs/DATA_ECOSYSTEM.md) ──────────────
# data/ is a local mirror of Drive StockMarket/data/v2, synced by
# packages/jobs-runtime/scripts/data.js. See skills/_shared/conventions.md §6–7.
# Data files must NEVER be committed; only allow-listed config below survives.
# (Per-scan announcement ignore keywords were removed 2026-07-11 in favor of a
# single shared list at stock-api/src/data/announcement-noise-keywords.json,
# which lives under source and isn't covered by this /data/* ignore.)
/data/*

# Legacy v1 store (superseded by data/; kept ignored as a guard)
jobs/data/
delivery_cache/
packages/jobs-runtime/data/

# Legacy stray output dirs at the repo root (written by older skill runs whose
# env resolution fell back to process.cwd(); kept ignored as a guard)
/daily_gainers/
/notes/
/validation/
/events/
/entities/
/documents/

# Legacy cowork-jobs paths (pre jobs-runtime relocation) — guard against revival
packages/cowork-jobs/
packages/cowork-jobs/process_watchlist.js

/tmp/
tmp_*
